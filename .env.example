# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
TELEGRAM_WEBHOOK_SECRET=some-hard-to-guess-string

# LLM (OpenAI-compatible endpoint)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1

# Log publishing (pushes logs/run_*.jsonl to a public GitHub repo)
GITHUB_TOKEN=ghp_...
GITHUB_LOG_REPO=yourname/telegram-bot-logs
GITHUB_LOG_BRANCH=main

# App
PORT=8000
ENV=production
# Set this to your deployed base URL (e.g. https://your-app.onrender.com)
# so the app can auto-register its Telegram webhook on startup.
PUBLIC_URL=
